NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side only. Required for the contribution calendar and contribution counts.
GITHUB_TOKEN=
# Optional: dashboard cache TTL in seconds (default 3600).
GITHUB_CACHE_SECONDS=3600
# Server-side Resend credentials; do not expose these using NEXT_PUBLIC_ names.
RESEND_API_KEY=
# Recipient inbox; this address is intentionally displayed as a public contact link.
CONTACT_EMAIL=
# Sender address accepted by the verified sending domain in Resend.
RESEND_FROM_EMAIL=
